# Set default behavior to automatically normalize line endings
* text=auto

# Enforce Unix (LF) line endings for specific text files
*.yml text eol=lf
*.yaml text eol=lf
*.j2 text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.conf text eol=lf

# Explicitly declare binary files to prevent them from being modified
*.tar.gz binary
*.zip binary
*.png binary
*.jpg binary
